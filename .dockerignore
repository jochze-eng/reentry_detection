# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.egg-info/
.eggs/
.venv/
venv/
env/

# Runtime data — never bake config into the image
config.json

# Licensing: vendor-only signing tools and the private key must never ship
tools/
license_priv.pem
*_priv.pem

# OS / IDE artefacts
.DS_Store
.idea/
.vscode/
*.swp

# Docker files (no need to include in build context)
docker-compose.yml
Dockerfile
.dockerignore
